config adio-controller general
	option enabled '1'

config adio-controller adc1
	option name 'ADC 1'
	option scale '0-50v'
	
config adio-controller adc2
	option name 'ADC 2'
	option scale '0-50v'
	
config adio-controller dac1
	option name 'DAC 1'
	option scale '0-5v'
	option value '0'
	
config adio-controller relay1
	option name 'RELAY 1'
	option value '0'
	
config adio-controller relay2
	option name 'RELAY 2'
	option value '0'
	
config adio-controller dio1
	option name 'DIO 1'
	option mode 'input'
	option value '0'
	
config adio-controller dio2
	option name 'DIO 2'
	option mode 'input'
	option value '0'
